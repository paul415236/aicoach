# 複製此檔為 .env 並填入你自己的值：cp .env.example .env
# .env 已被 .gitignore 忽略，不會被 commit。

# Garmin Connect 帳號
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_garmin_password

# OpenRouter API Key（免費申請：https://openrouter.ai/ → Keys）
OPENROUTER_API_KEY=sk-or-...

# （選用）覆寫 AI 使用的模型清單，逗號分隔，依序 fallback
# 未設定時使用程式內建的免費模型清單
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free
